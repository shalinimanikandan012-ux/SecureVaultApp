# SecureVaultApp Backend Configuration
# SERVER-SIDE SECRETS ONLY (DO NOT COMMIT REAL SECRETS)

FLASK_ENV="production"
FLASK_DEBUG="0"
SECRET_KEY="generate-a-strong-random-hex-string-for-flask-sessions"

# Database Connection (PostgreSQL for Production, SQLite for local dev)
# Local: sqlite:///securevault.db
# Prod: postgresql://user:password@host:5432/securevault
DATABASE_URL="sqlite:///securevault.db"

# Allowed Frontend Origin for CORS
FRONTEND_ORIGIN="http://localhost:3000"

# Upload Constraints (Bytes) - 15MB limit
MAX_CONTENT_LENGTH="15728640"

# Rate Limiting & Lockout Parameters
MAX_LOGIN_ATTEMPTS="5"
LOCKOUT_MINUTES="15"
SESSION_EXPIRY_HOURS="2"
